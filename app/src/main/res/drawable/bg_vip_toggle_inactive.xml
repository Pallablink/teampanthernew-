<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40EF4444">
    <item>
        <layer-list>
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="2dp" />
                    <solid android:color="#0D0B0E" />
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="2dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#26161D"
                        android:centerColor="#181115"
                        android:endColor="#140C10"
                        android:type="linear" />
                    <stroke
                        android:width="1dp"
                        android:color="#40EF4444" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>

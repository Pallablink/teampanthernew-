<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <layer-list>
            <!-- 3D Bottom Drop Shadow / Base Edge -->
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="2dp" />
                    <solid android:color="#064E3B" />
                </shape>
            </item>

            <!-- 3D Solid Emerald Beveled Body (Sharp Rectangle) -->
            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="2dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#34D399"
                        android:centerColor="#10B981"
                        android:endColor="#059669"
                        android:type="linear" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#A7F3D0" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>

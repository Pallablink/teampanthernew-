<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_hud_glass_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- Header Icon -->
    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/icon_settings_3d" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:letterSpacing="0.06"
        android:text="CHANGE PASSWORD"
        android:textColor="@color/vip_gold"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="Update your VIP account security credentials."
        android:textColor="@color/vip_text_secondary"
        android:textSize="11sp" />

    <!-- Input Fields Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <!-- 1. Current Password -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.BdgGameAiTradeBot.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Current Password"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/vip_gold">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCurrentPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="@color/vip_white"
                android:textSize="12sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 2. New Password -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.BdgGameAiTradeBot.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="New Password (min 6 chars)"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/vip_gold">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNewPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="@color/vip_white"
                android:textSize="12sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 3. Confirm New Password -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.BdgGameAiTradeBot.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Confirm New Password"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/vip_gold">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etConfirmNewPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="@color/vip_white"
                android:textSize="12sp" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelChangePass"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_vip_secondary_btn"
            android:letterSpacing="0.04"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/vip_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitChangePass"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1.3"
            android:background="@drawable/bg_bot_btn_running"
            android:letterSpacing="0.04"
            android:text="Update"
            android:textAllCaps="false"
            android:textColor="@color/vip_white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="2dp" />
    </LinearLayout>

</LinearLayout>




<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vip_bg_dark">

    <!-- High-Definition VIP Cyber Graphic Wallpaper -->
    <ImageView
        android:id="@+id/ivBackgroundGraphic"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Background"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_vip_cyber" />

    <!-- Dark Ambient Contrast Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <!-- Main Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="36dp"
            android:paddingEnd="22dp"
            android:paddingBottom="42dp">

            <!-- ============================================== -->
            <!-- VIP BRANDING HEADER                            -->
            <!-- ============================================== -->
            <LinearLayout
                android:id="@+id/layoutHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <!-- 3D Logo with Glowing Halo Ring -->
                <FrameLayout
                    android:id="@+id/layoutLogoContainer"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:background="@drawable/bg_logo_halo"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/ivLogo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/app_name"
                        android:scaleType="fitCenter"
                        android:src="@drawable/logo_vip_bot" />
                </FrameLayout>

                <!-- App Name Title with Gold Shadow -->
                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:letterSpacing="0.08"
                    android:shadowColor="#80F59E0B"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="14"
                    android:text="@string/app_name"
                    android:textColor="@color/vip_white"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <!-- Tagline Badge -->
                <TextView
                    android:id="@+id/tvTagline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_tab_container"
                    android:letterSpacing="0.04"
                    android:paddingStart="14dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="4dp"
                    android:text="PREMIUM BOT AUTOMATION"
                    android:textColor="@color/vip_gold"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ============================================== -->
            <!-- MODERN SEGMENTED SLIDING TAB SWITCHER          -->
            <!-- ============================================== -->
            <LinearLayout
                android:id="@+id/layoutTabSwitcher"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_tab_container"
                android:orientation="horizontal"
                android:padding="4dp">

                <!-- Sign In Tab -->
                <TextView
                    android:id="@+id/tabSignIn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tab_active_gold"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:letterSpacing="0.04"
                    android:text="@string/tab_sign_in"
                    android:textColor="@color/vip_white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Register Tab -->
                <TextView
                    android:id="@+id/tabRegister"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:letterSpacing="0.04"
                    android:text="@string/tab_register"
                    android:textColor="@color/vip_text_secondary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ============================================== -->
            <!-- CYBER GLASS CARD CONTAINER                     -->
            <!-- ============================================== -->
            <FrameLayout
                android:id="@+id/cardAuthContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card_cyber_glass"
                android:elevation="12dp"
                android:paddingStart="22dp"
                android:paddingTop="28dp"
                android:paddingEnd="22dp"
                android:paddingBottom="30dp">

                <!-- 3D Specular Light Glare Overlay -->
                <View
                    android:id="@+id/viewCardGlare"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0"
                    android:background="@drawable/bg_card_glare"
                    android:clickable="false"
                    android:focusable="false" />

                <!-- ========================================== -->
                <!-- 1. LOGIN SECTION                           -->
                <!-- ========================================== -->
                <LinearLayout
                    android:id="@+id/layoutLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/welcome_back"
                        android:textColor="@color/vip_text_primary"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/login_subtitle"
                        android:textColor="@color/vip_text_secondary"
                        android:textSize="13sp" />

                    <!-- Input: Email or Phone Number -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilLoginIdentifier"
                        style="@style/Widget.BdgGameAiTradeBot.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:hint="Email or Phone Number"
                        app:startIconDrawable="@drawable/ic_mail">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etLoginIdentifier"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:textColor="@color/vip_text_primary"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Input: Password -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilLoginPassword"
                        style="@style/Widget.BdgGameAiTradeBot.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="@string/label_password"
                        app:endIconMode="password_toggle"
                        app:startIconDrawable="@drawable/ic_lock">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etLoginPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textColor="@color/vip_text_primary"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Row: Remember Me & Forgot Password -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp">

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbRememberMe"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:text="@string/remember_me"
                            android:textColor="@color/vip_text_secondary"
                            android:textSize="13sp"
                            app:buttonTint="@color/vip_gold" />

                        <TextView
                            android:id="@+id/tvForgotPassword"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="6dp"
                            android:text="@string/forgot_password"
                            android:textColor="@color/vip_accent_cyan"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <!-- Sign In Button (VIP Gold Gradient) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogin"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="22dp"
                        android:background="@drawable/bg_btn_vip_gold"
                        android:elevation="6dp"
                        android:letterSpacing="0.06"
                        android:text="SIGN IN TO DASHBOARD"
                        android:textAllCaps="true"
                        android:textColor="@color/vip_white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null"
                        app:cornerRadius="2dp" />

                    <!-- Login Progress Indicator -->
                    <ProgressBar
                        android:id="@+id/pbLoginLoading"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp"
                        android:indeterminateTint="@color/vip_gold"
                        android:visibility="gone" />

                    <!-- Bottom Switch Link to Register -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/no_account"
                            android:textColor="@color/vip_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvSwitchToRegister"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="@string/register_now"
                            android:textColor="@color/vip_gold"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

                <!-- ========================================== -->
                <!-- 2. REGISTER SECTION (Clean: No Username)   -->
                <!-- ========================================== -->
                <LinearLayout
                    android:id="@+id/layoutRegister"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Create Account"
                        android:textColor="@color/vip_text_primary"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Enter your details to create your VIP bot access"
                        android:textColor="@color/vip_text_secondary"
                        android:textSize="13sp" />

                    <!-- Register: Phone Number Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilRegPhone"
                        style="@style/Widget.BdgGameAiTradeBot.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:hint="@string/label_phone"
                        app:startIconDrawable="@drawable/ic_phone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etRegPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="phone"
                            android:textColor="@color/vip_text_primary"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Register: Email Address Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilRegEmail"
                        style="@style/Widget.BdgGameAiTradeBot.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="@string/label_email"
                        app:startIconDrawable="@drawable/ic_mail">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etRegEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:textColor="@color/vip_text_primary"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Register: Password Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilRegPassword"
                        style="@style/Widget.BdgGameAiTradeBot.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="@string/label_password"
                        app:endIconMode="password_toggle"
                        app:startIconDrawable="@drawable/ic_lock">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etRegPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textColor="@color/vip_text_primary"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Register: Confirm Password Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilRegConfirmPassword"
                        style="@style/Widget.BdgGameAiTradeBot.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="@string/label_confirm_password"
                        app:endIconMode="password_toggle"
                        app:startIconDrawable="@drawable/ic_lock">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etRegConfirmPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textColor="@color/vip_text_primary"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Checkbox: Terms & Privacy -->
                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbTerms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/agree_terms"
                        android:textColor="@color/vip_text_secondary"
                        android:textSize="13sp"
                        app:buttonTint="@color/vip_gold" />

                    <!-- Register Button (VIP Gold Gradient) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRegister"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_btn_vip_gold"
                        android:elevation="6dp"
                        android:letterSpacing="0.06"
                        android:text="CREATE VIP ACCOUNT"
                        android:textAllCaps="true"
                        android:textColor="@color/vip_white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null"
                        app:cornerRadius="2dp" />

                    <!-- Register Progress Indicator -->
                    <ProgressBar
                        android:id="@+id/pbRegisterLoading"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp"
                        android:indeterminateTint="@color/vip_gold"
                        android:visibility="gone" />

                    <!-- Bottom Switch Link to Login -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/have_account"
                            android:textColor="@color/vip_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvSwitchToLogin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="@string/sign_in_now"
                            android:textColor="@color/vip_gold"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>




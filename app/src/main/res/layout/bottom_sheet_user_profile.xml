<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_hud_glass_card"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Drag Handle -->
        <View
            android:layout_width="44dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_tab_inactive" />

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/icon_settings_3d" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:letterSpacing="0.06"
                    android:text="VIP USER PROFILE"
                    android:textColor="@color/vip_gold"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnCloseProfile"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_header_action_btn"
                android:contentDescription="Close"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_minimize_3d" />
        </RelativeLayout>

        <!-- AVATAR SELECTION SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_hud_card_item"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Active Selected Avatar -->
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivCurrentAvatar"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_tab_active_gold"
                    android:padding="3dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_default_robot"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_alignEnd="@id/ivCurrentAvatar"
                    android:layout_alignBottom="@id/ivCurrentAvatar"
                    android:background="@drawable/bg_header_action_btn"
                    android:padding="3dp"
                    android:src="@drawable/icon_settings_3d" />
            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:letterSpacing="0.04"
                android:text="SELECT VIP AVATAR"
                android:textColor="@color/vip_gold"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <!-- 4 Preset Default Avatars -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- 1. Tiger -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivPresetTiger"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/avatar_default_tiger"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

                <!-- 2. Robot -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivPresetRobot"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/avatar_default_robot"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

                <!-- 3. Crown -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivPresetCrown"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/avatar_default_crown"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

                <!-- 4. Shield -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivPresetShield"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/avatar_default_shield"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
            </LinearLayout>

            <!-- Choose from Gallery Button -->
            <TextView
                android:id="@+id/btnPickGallery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_header_btn_cyan"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:text="Choose from Device Gallery"
                android:textColor="@color/vip_accent_cyan"
                android:textSize="10.5sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- USER DETAILS & ADMIN STATUS CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_hud_card_item"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ACCOUNT STATUS"
                    android:textColor="@color/vip_text_hint"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <!-- Dynamic Status Badge: ACTIVE, INACTIVE, BANNED, SUSPENDED -->
                <TextView
                    android:id="@+id/tvUserStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_history_w"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:text="ACTIVE"
                    android:textColor="@color/vip_white"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAdminSyncNotice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Synced from Central Admin Panel"
                android:textColor="@color/vip_gold"
                android:textSize="9sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="#15FFFFFF" />

            <!-- Phone Number -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="Phone:"
                    android:textColor="@color/vip_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvProfilePhone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="+91 98765 43210"
                    android:textColor="@color/vip_white"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Email Address -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="Email:"
                    android:textColor="@color/vip_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvProfileEmail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="user@teampanther.com"
                    android:textColor="@color/vip_white"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <!-- ACTION BUTTONS: CHANGE PASSWORD, CONTACT SUPPORT, FEEDBACK, LOGOUT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <!-- 1. Change Password -->
            <LinearLayout
                android:id="@+id/btnChangePassword"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_hud_card_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_lock" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Change Password"
                    android:textColor="@color/vip_white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/vip_text_hint"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- 2. Contact Support -->
            <LinearLayout
                android:id="@+id/btnContactSupport"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_hud_card_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_headset" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Contact Support"
                    android:textColor="@color/vip_white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/vip_text_hint"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- 3. Feedback -->
            <LinearLayout
                android:id="@+id/btnFeedback"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_hud_card_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chat" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Send Feedback"
                    android:textColor="@color/vip_white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/vip_text_hint"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- 4. Logout Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_bot_btn_stopped"
                android:letterSpacing="0.04"
                android:text="LOGOUT FROM APP"
                android:textAllCaps="false"
                android:textColor="@color/vip_white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:icon="@drawable/icon_logout_3d"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="18dp"
                app:backgroundTint="@null"
                app:cornerRadius="2dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>




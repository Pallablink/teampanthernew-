<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="16dp"
    android:paddingEnd="24dp"
    android:paddingBottom="32dp">

    <!-- Bottom Sheet Drag Handle -->
    <View
        android:layout_width="48dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_tab_container" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvForgotTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/forgot_dialog_title"
        android:textColor="@color/vip_text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Description -->
    <TextView
        android:id="@+id/tvForgotDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:lineSpacingExtra="3dp"
        android:text="@string/forgot_dialog_desc"
        android:textColor="@color/vip_text_secondary"
        android:textSize="14sp" />

    <!-- Input for Email or Phone -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilResetTarget"
        style="@style/Widget.BdgGameAiTradeBot.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/label_reset_target"
        app:startIconDrawable="@drawable/ic_mail">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etResetTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress"
            android:textColor="@color/vip_text_primary"
            android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Send Reset Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSendReset"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_btn_gradient"
        android:letterSpacing="0.04"
        android:text="@string/btn_send_reset"
        android:textAllCaps="false"
        android:textColor="@color/vip_white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:cornerRadius="2dp" />

    <!-- Progress indicator (hidden by default) -->
    <ProgressBar
        android:id="@+id/pbResetLoading"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:indeterminateTint="@color/vip_primary"
        android:visibility="gone" />

</LinearLayout>




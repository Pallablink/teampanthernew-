<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_hud_glass_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- Header Icon -->
    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/icon_analytics_3d" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:letterSpacing="0.06"
        android:text="SEND VIP FEEDBACK"
        android:textColor="@color/vip_gold"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="Your valuable feedback helps our engineering team optimize bot signals."
        android:textColor="@color/vip_text_secondary"
        android:textSize="11sp" />

    <!-- Star Rating Row -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:letterSpacing="0.1"
        android:text="⭐⭐⭐⭐⭐"
        android:textSize="22sp" />

    <!-- Feedback Message Input -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.BdgGameAiTradeBot.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="Write your feedback / suggestion...">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etFeedbackMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:textColor="@color/vip_white"
            android:textSize="12sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelFeedback"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_vip_secondary_btn"
            android:letterSpacing="0.04"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/vip_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitFeedback"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1.3"
            android:background="@drawable/bg_btn_vip_gold"
            android:letterSpacing="0.04"
            android:text="Submit"
            android:textAllCaps="false"
            android:textColor="@color/vip_white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="2dp" />
    </LinearLayout>

</LinearLayout>




<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_hud_glass_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- 3D Exit Icon -->
    <ImageView
        android:id="@+id/ivExitIcon"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:scaleType="fitCenter"
        android:src="@drawable/icon_logout_3d" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvExitTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:letterSpacing="0.06"
        android:text="EXIT TeamPanther"
        android:textColor="@color/vip_gold"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Message -->
    <TextView
        android:id="@+id/tvExitMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="Do you want to exit the application? Active bot automation and live predictions will be paused."
        android:textColor="@color/vip_text_secondary"
        android:textSize="12sp" />

    <!-- Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">

        <!-- Stay Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStay"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_bot_btn_running"
            android:letterSpacing="0.04"
            android:text="STAY"
            android:textAllCaps="false"
            android:textColor="@color/vip_white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="2dp" />

        <!-- Exit Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_bot_btn_stopped"
            android:letterSpacing="0.04"
            android:text="EXIT"
            android:textAllCaps="false"
            android:textColor="@color/vip_white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="2dp" />

    </LinearLayout>

</LinearLayout>




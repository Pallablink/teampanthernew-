<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_hud_card_item"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Top Row: Period, Choice Badge, Level & Outcome Badge -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRowPeriod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.04"
                android:text="#1271"
                android:textColor="@color/vip_white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Choice Badge: BIG or SMALL -->
            <TextView
                android:id="@+id/tvRowChoice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_vip_chip_btn"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="BIG"
                android:textColor="@color/vip_gold"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRowLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="LVL 1"
                android:textColor="@color/vip_text_hint"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Outcome Badge: WIN, LOSS, PENDING -->
        <TextView
            android:id="@+id/tvRowStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_history_w"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="WIN"
            android:textColor="@color/vip_white"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Bottom Row: Stake, Net Profit & Time -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/tvRowStake"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stake: ₹15.00"
            android:textColor="@color/vip_text_secondary"
            android:textSize="10.5sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRowProfit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+₹14.40"
                android:textColor="@color/vip_success"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRowTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="02:40 PM"
                android:textColor="@color/vip_text_hint"
                android:textSize="9.5sp" />
        </LinearLayout>
    </RelativeLayout>

</LinearLayout>


